# Supabase Configuration
# Obtén estas credenciales desde tu proyecto en https://supabase.com/dashboard
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_clave_publica_anonima_aqui

# Socket.IO Backend URL
# URL del servidor Flask que maneja las explicaciones con IA
PUBLIC_SOCKET_URL=http://localhost:5000

# Opcional: Si necesitas configurar el puerto del servidor de desarrollo
# PORT=5173
